# Copy to .env and adjust for your environment

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mission_control.db
# DATABASE_URL=postgresql+asyncpg://mission:mission@localhost:5432/mission_control

# Redis (set USE_REDIS=true to activate RedisStreamBus; auto-falls back to in-memory if Redis is unreachable)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Simulation tuning
SIM_STEP_DELAY_SECONDS=0.5
COMM_DELAY_SECONDS=2.5

# CORS (comma-separated allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Claude API — set to enable AI-powered explanations in the Explain tab (V3)
# ANTHROPIC_API_KEY=sk-
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# RL Planner tuning (V3)
RL_EPISODE_BUDGET=500
RL_WEIGHT_TARGET=2.0
RL_WEIGHT_TERRAIN=1.0
RL_WEIGHT_GEYSER=3.0

# Physics simulation (V3)
PHYSICS_ELEVATION_COST_FACTOR=0.5
PHYSICS_THERMAL_ANOMALY_SCALE=1.0

# Fog of War (V4)
FOG_OF_WAR=true          # set to false to reveal all terrain from the start
SENSOR_RANGE=2           # cells revealed in each direction when a rover moves (Chebyshev distance)

# Fault Protection System (V4)
FPS_WHEEL_STUCK_RETRY_LIMIT=2    # retries before FPS attempts a reverse manoeuvre
FPS_COMM_LOSS_RETRY_LIMIT=2      # wait cycles before declaring safe mode on comm loss
FPS_SAFE_MODE_BATTERY_PCT=10.0   # battery % below which FPS forces safe mode

# Dynamic Terrain Events (V4)
TERRAIN_GEYSER_CYCLE_TICKS=15        # steps between geyser eruption/dormancy evaluations
TERRAIN_GEYSER_FLIP_PROB=0.35        # probability each geyser changes state per cycle
TERRAIN_FRACTURE_PROB_PER_TICK=0.004 # probability crevasse spreads to adjacent cell per step
TERRAIN_FROST_PERIOD_TICKS=20        # full day/night cycle length (night = half)
TERRAIN_FROST_COST_FACTOR=1.4        # movement cost multiplier on flat/ice during night

# AEGIS Autonomous Target Selection (V4)
AEGIS_MAX_AUTO_OBJECTIVES=10   # cap on self-generated objectives per mission run (0 = unlimited)

# Communication Windows (V4)
COMM_SLOT_SECONDS=60             # seconds between successive uplink window openings
COMM_WINDOW_DURATION_SECONDS=15  # how long each uplink window stays open
